<#
.EXAMPLES
  ./Export-PolicyDenies.ps1 -TenantId <tenant-guid>
  ./Export-PolicyDenies.ps1 -TenantId <tenant-guid> -Days 30 -Granularity Resource
  ./Export-PolicyDenies.ps1 -TenantId <tenant-guid> -Days 7 -MaskUserCallers
#>

param(
    [ValidatePattern('^[0-9a-fA-F-]{36}$')]
    [string]$TenantId,

    [ValidateRange(1, 90)]
    [int]$Days = 7,

    [ValidateSet("Deployment", "Resource")]
    [string]$Granularity = "Deployment",

    [switch]$IncludeToday,

    # Replace user UPNs with a pseudonym (service principal names are kept)
    [switch]$MaskUserCallers,

    [ValidateScript({ Test-Path $_ -PathType Container })]
    [string]$OutputPath
)

$ErrorActionPreference = "Stop"
$ScriptVersion = "1.1.0"

# ---------------------------------------------------------------------------
# Known service principals (pipelines, automations). Add as you find them:
#   search the GUID in Entra ID -> Enterprise applications
# ---------------------------------------------------------------------------
$knownCallers = @{
    "f66d954a-dbd2-42ab-a631-81d5eeaf594c" = "hcp-terraform-cloud"
    # "<app-or-object-id>" = "<name>"
}

# ---------------------------------------------------------------------------
# Login / tenant pinning
# ---------------------------------------------------------------------------
$ctx = Get-AzContext
if (-not $ctx) {
    if ($TenantId) { Connect-AzAccount -Tenant $TenantId | Out-Null } else { Connect-AzAccount | Out-Null }
    $ctx = Get-AzContext
}
if ($TenantId -and $ctx.Tenant.Id -ne $TenantId) {
    throw "Current context is tenant '$($ctx.Tenant.Id)', expected '$TenantId'. Run: Connect-AzAccount -Tenant $TenantId"
}
$tenant = $ctx.Tenant.Id
$runBy  = $ctx.Account.Id

# ---------------------------------------------------------------------------
# Time window and time zone (Brasília, fixed UTC-3 since 2019)
# ---------------------------------------------------------------------------
$fmt   = "yyyy-MM-ddTHH:mm:ssZ"
$now   = (Get-Date).ToUniversalTime()
$end   = if ($IncludeToday) { $now } else { $now.Date }
$start = $now.Date.AddDays(-$Days)

$tz = $null
foreach ($id in "E. South America Standard Time", "America/Sao_Paulo") {
    try { $tz = [TimeZoneInfo]::FindSystemTimeZoneById($id); break } catch { }
}
if (-not $tz) { $tz = [TimeZoneInfo]::CreateCustomTimeZone("BRT", [TimeSpan]::FromHours(-3), "BRT", "BRT") }

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
$script:nameCache = @{}
$script:maskSalt  = [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(16))

function Get-ResourceType([string]$ResourceId) {
    $tail = ($ResourceId -split '/providers/')[-1] -split '/'
    if ($tail.Count -lt 3) { return $null }
    $types = for ($i = 1; $i -lt $tail.Count; $i += 2) { $tail[$i] }
    "$($tail[0])/$($types -join '/')"
}

# Pseudonym for user UPNs: consistent within one run, salted so it can't be reversed with a list of employees
function Protect-Caller([string]$Name) {
    if (-not $MaskUserCallers -or $Name -notlike '*@*') { return $Name }
    $bytes = [Text.Encoding]::UTF8.GetBytes("$($script:maskSalt)|$($Name.ToLowerInvariant())")
    "user-" + [Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData($bytes)).Substring(0, 10).ToLowerInvariant()
}

function Get-CallerName([string]$Caller) {
    if ([string]::IsNullOrEmpty($Caller)) { return $Caller }
    if ($Caller -like '*@*') { return (Protect-Caller $Caller) }                 # users come as UPN
    if ($knownCallers.ContainsKey($Caller)) { return $knownCallers[$Caller] }
    if ($script:nameCache.ContainsKey($Caller)) { return $script:nameCache[$Caller] }

    $name = $null
    try {
        $sp = Get-AzADServicePrincipal -ApplicationId $Caller -ErrorAction SilentlyContinue
        if (-not $sp) { $sp = Get-AzADServicePrincipal -ObjectId $Caller -ErrorAction SilentlyContinue }
        if ($sp) { $name = $sp.DisplayName }
    } catch { }
    if (-not $name) { $name = "(unresolved) $Caller" }

    $script:nameCache[$Caller] = $name
    $name
}

# Read-only GET with retry (honors Retry-After) and host validation
function Invoke-ArmGet {
    param([string]$Path, [string]$Uri)

    if ($Uri) {
        $u = [uri]$Uri
        if ($u.Scheme -ne 'https' -or $u.Host -ne 'management.azure.com') {
            throw "Refusing to follow unexpected URL host '$($u.Host)'"     # never send the token elsewhere
        }
    }

    for ($attempt = 1; $attempt -le 5; $attempt++) {
        $resp = if ($Uri) { Invoke-AzRestMethod -Method GET -Uri $Uri } else { Invoke-AzRestMethod -Method GET -Path $Path }
        if ($resp.StatusCode -eq 200) { return $resp }

        if ($resp.StatusCode -in 429, 500, 502, 503, 504) {
            $delay = 10 * $attempt
            try {
                $ra = $resp.Headers.RetryAfter
                if ($ra -and $ra.Delta) { $delay = [math]::Max($delay, [int][math]::Ceiling($ra.Delta.TotalSeconds)) }
            } catch { }
            $delay += Get-Random -Minimum 0 -Maximum 3
            Write-Host "    HTTP $($resp.StatusCode) - retry $attempt in ${delay}s" -ForegroundColor Yellow
            Start-Sleep -Seconds $delay
            continue
        }

        $msg = "$($resp.Content)"
        if ($msg.Length -gt 300) { $msg = $msg.Substring(0, 300) + "..." }
        throw "HTTP $($resp.StatusCode): $msg"
    }
    throw "HTTP $($resp.StatusCode) after 5 attempts"
}

function Join-Unique($Values) {
    (@($Values -split '; ' | Where-Object { $_ } | Select-Object -Unique) -join '; ')
}

# CSV/formula injection protection (OWASP): prefix cells starting with = + - @ tab CR
function ConvertTo-SafeRow($Row) {
    $safe = [ordered]@{}
    foreach ($p in $Row.PSObject.Properties) {
        $v = $p.Value
        if ($v -is [string] -and $v -match '^[=+\-@\t\r]') { $v = "'" + $v }
        $safe[$p.Name] = $v
    }
    [pscustomobject]$safe
}

# ---------------------------------------------------------------------------
# Collect deny events
# ---------------------------------------------------------------------------
$subs   = @(Get-AzSubscription -TenantId $tenant | Where-Object State -eq 'Enabled')
$events = [System.Collections.Generic.List[object]]::new()
$failed = [System.Collections.Generic.List[object]]::new()

Write-Host "Script v$ScriptVersion | Tenant: $tenant | Run by: $runBy"
Write-Host "Period (UTC): $($start.ToString($fmt)) -> $($end.ToString($fmt))"
Write-Host "Subscriptions: $($subs.Count) | Granularity: $Granularity | Mask users: $([bool]$MaskUserCallers)`n"

$flt    = "eventTimestamp ge '$($start.ToString($fmt))' and eventTimestamp le '$($end.ToString($fmt))'"
$select = "eventTimestamp,operationName,caller,correlationId,resourceGroupName,resourceId,properties"
$i = 0

foreach ($sub in $subs) {
    $i++
    try {
        $path = "/subscriptions/$($sub.Id)/providers/Microsoft.Insights/eventtypes/management/values" +
                "?api-version=2015-04-01&`$filter=$([uri]::EscapeDataString($flt))&`$select=$select"

        $count = 0
        $resp  = Invoke-ArmGet -Path $path
        while ($true) {
            $page   = $resp.Content | ConvertFrom-Json
            $denies = @($page.value | Where-Object { $_.operationName.value -eq 'Microsoft.Authorization/policies/deny/action' })

            foreach ($e in $denies) {
                $count++
                $pols = @($e.properties.policies | ConvertFrom-Json)
                $utc  = ([datetime]$e.eventTimestamp).ToUniversalTime()

                $events.Add([pscustomobject]@{
                    DateTimeBRT      = [TimeZoneInfo]::ConvertTimeFromUtc($utc, $tz).ToString("yyyy-MM-dd HH:mm:ss")
                    Subscription     = $sub.Name
                    SubscriptionId   = $sub.Id
                    ResourceGroup    = $e.resourceGroupName
                    Resource         = ($e.resourceId -split '/')[-1]
                    ResourceType     = Get-ResourceType $e.resourceId
                    Initiatives      = (@($pols.policySetDefinitionDisplayName | Where-Object { $_ } | Select-Object -Unique) -join '; ')
                    Policies         = (@($pols.policyDefinitionDisplayName | Select-Object -Unique) -join '; ')
                    AssignmentScopes = (@($pols.policyAssignmentScope | Select-Object -Unique) -join '; ')
                    CallerName       = Get-CallerName $e.caller
                    CallerId         = $(if ($MaskUserCallers -and "$($e.caller)" -like '*@*') { Protect-Caller $e.caller } else { $e.caller })
                    CorrelationId    = $e.correlationId
                })
            }

            if (-not $page.nextLink) { break }
            $resp = Invoke-ArmGet -Uri $page.nextLink
        }
        Write-Host ("[{0}/{1}] {2}: {3} deny events" -f $i, $subs.Count, $sub.Name, $count)
    }
    catch {
        $failed.Add([pscustomobject]@{ Subscription = $sub.Name; SubscriptionId = $sub.Id; Error = $_.Exception.Message })
        Write-Warning "[$i/$($subs.Count)] $($sub.Name): $($_.Exception.Message)"
    }
    Start-Sleep -Milliseconds 300
}

# ---------------------------------------------------------------------------
# Shape output
# ---------------------------------------------------------------------------
if ($Granularity -eq "Deployment") {
    $out = $events | Group-Object CorrelationId, SubscriptionId | ForEach-Object {
        $g = $_.Group
        [pscustomobject]@{
            DateTimeBRT      = @($g.DateTimeBRT | Sort-Object)[0]
            Subscription     = $g[0].Subscription
            SubscriptionId   = $g[0].SubscriptionId
            ResourceGroups   = Join-Unique $g.ResourceGroup
            BlockedResources = $g.Count
            Resources        = Join-Unique $g.Resource
            ResourceTypes    = Join-Unique $g.ResourceType
            Initiatives      = Join-Unique $g.Initiatives
            Policies         = Join-Unique $g.Policies
            AssignmentScopes = Join-Unique $g.AssignmentScopes
            CallerName       = $g[0].CallerName
            CallerId         = $g[0].CallerId
            CorrelationId    = $g[0].CorrelationId
        }
    }
}
else {
    $out = $events
}
$out = @($out | Sort-Object DateTimeBRT -Descending | ForEach-Object { ConvertTo-SafeRow $_ })

# ---------------------------------------------------------------------------
# Save CSV (UTF-8 with BOM so Excel shows accents correctly) + manifest
# ---------------------------------------------------------------------------
$dir = if ($OutputPath) { $OutputPath } elseif (Test-Path "$HOME/clouddrive") { "$HOME/clouddrive" } else { $HOME }
$baseName = "policy-denies_$($start.ToString('yyyy-MM-dd'))_$($Days)d_$($Granularity.ToLower())"
$file     = Join-Path $dir "$baseName.csv"
$manifest = Join-Path $dir "$baseName.manifest.json"

if ($out.Count -gt 0) {
    $out | Export-Csv $file -NoTypeInformation -Encoding utf8BOM
}
else {
    "No deny events between $($start.ToString($fmt)) and $($end.ToString($fmt))" | Set-Content $file -Encoding utf8BOM
}

[ordered]@{
    scriptVersion       = $ScriptVersion
    runAtUtc            = (Get-Date).ToUniversalTime().ToString($fmt)
    runBy               = $runBy
    tenantId            = $tenant
    periodStartUtc      = $start.ToString($fmt)
    periodEndUtc        = $end.ToString($fmt)
    granularity         = $Granularity
    maskedUserCallers   = [bool]$MaskUserCallers
    subscriptionsTotal  = $subs.Count
    subscriptionsFailed = @($failed)
    denyEvents          = $events.Count
    blockedDeployments  = @($events.CorrelationId | Select-Object -Unique).Count
    outputRows          = $out.Count
    csvFile             = (Split-Path $file -Leaf)
    csvSha256           = (Get-FileHash $file -Algorithm SHA256).Hash
} | ConvertTo-Json -Depth 4 | Set-Content $manifest -Encoding utf8

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
Write-Host "`n===== Summary ====="
Write-Host "Deny events (blocked resources): $($events.Count)"
Write-Host "Blocked deployments:             $(@($events.CorrelationId | Select-Object -Unique).Count)"
if ($events.Count -gt 0) {
    Write-Host "`nTop policies:"
    $events | ForEach-Object { $_.Policies -split '; ' } | Group-Object | Sort-Object Count -Descending |
        Select-Object -First 10 -Property Count, Name | Format-Table -AutoSize | Out-String -Width 200 | Write-Host
    Write-Host "Top callers:"
    $events | Group-Object CallerName | Sort-Object Count -Descending |
        Select-Object -First 10 -Property Count, Name | Format-Table -AutoSize | Out-String -Width 200 | Write-Host
}
if ($failed.Count -gt 0) { Write-Warning "Subscriptions with errors ($($failed.Count)): $($failed.Subscription -join ', ')" }

Write-Host "Saved:    $file ($($out.Count) rows)" -ForegroundColor Green
Write-Host "Manifest: $manifest" -ForegroundColor Green
Write-Host "Reminder: the CSV contains internal data. After downloading, remove it from Cloud Shell storage:" -ForegroundColor Yellow
Write-Host "  Remove-Item '$file', '$manifest'" -ForegroundColor Yellow
