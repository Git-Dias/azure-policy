## 6. Gerar eventos de deny

### 6.1. Bash

```bash
S=$RANDOM
az group create -n rg-denytest -l brazilsouth

# 00 Controle (deve ser CRIADO)
az storage account create -g rg-denytest -n stdtok$S -l brazilsouth --sku Standard_LRS \
  --https-only true --allow-blob-public-access false --allow-shared-key-access false

# 01 Allowed locations
az storage account create -g rg-denytest -n stdtloc$S -l eastus --sku Standard_LRS \
  --https-only true --allow-blob-public-access false --allow-shared-key-access false

# 02 Secure transfer
az storage account create -g rg-denytest -n stdthttp$S -l brazilsouth --sku Standard_LRS \
  --https-only false --allow-blob-public-access false --allow-shared-key-access false

# 03 Public access
az storage account create -g rg-denytest -n stdtpub$S -l brazilsouth --sku Standard_LRS \
  --https-only true --allow-blob-public-access true --allow-shared-key-access false

# 04 Shared key access
az storage account create -g rg-denytest -n stdtkey$S -l brazilsouth --sku Standard_LRS \
  --https-only true --allow-blob-public-access false --allow-shared-key-access true

# 05 As quatro violações em uma requisição (1 evento, 4 policies)
az storage account create -g rg-denytest -n stdtall$S -l eastus --sku Standard_LRS \
  --https-only false --allow-blob-public-access true --allow-shared-key-access true

# 06 Update de recurso existente
az storage account update -g rg-denytest -n stdtok$S --https-only false

# 07 Event Hubs TLS 1.0
az eventhubs namespace create -g rg-denytest -n ehdt$S -l brazilsouth --sku Basic --minimum-tls-version 1.0

# 08 Service Bus TLS 1.0
az servicebus namespace create -g rg-denytest -n sbdt$S -l brazilsouth --sku Basic --min-tls 1.0

# 09 IoT Hub TLS 1.0
az iot hub create -g rg-denytest -n iotdt$S -l brazilsouth --sku F1 --partition-count 2 --min-tls-version 1.0

# 10 VM sem CMK nos discos
az vm create -g rg-denytest -n vmdt$S -l brazilsouth --image Ubuntu2204 --size Standard_B1s \
  --admin-username azureuser --generate-ssh-keys --public-ip-address '""' --nsg '""'
```

